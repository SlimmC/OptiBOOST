{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "../src",
    "distDir": "../src",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "OptiBOOST",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": false
      }
    },
    "bundle": {
      "active": true,
      "targets": ["nsis"],
      "identifier": "com.optiboost.app",
      "icon": [
        "icons/icon.ico"
      ]
    },
    "windows": [
      {
        "title": "OptiBOOST - 1-Click Game Optimizer",
        "width": 1280,
        "height": 850,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ]
  }
}
